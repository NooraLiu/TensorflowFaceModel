rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /participants/{participantId} {
      // Participants can create and update their own document (write-only from the browser).
      // Reading and deleting is disabled — use the Firebase Console to export your data.
      allow create, update: if true;
      allow read, delete: if false;
    }
  }
}
